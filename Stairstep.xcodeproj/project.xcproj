{
  "default-configuration": "Debug",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "path": "README.md" },
    { "path": "Package.swift" },
    {
      "kind": "group",
      "path": "Sources",
      "children": [
        {
          "kind": "group",
          "path": "Stairs",
          "children": [
            { "path": "StairsApp.swift", "target-membership": [ "Stairstep/compile-sources" ] },
            { "path": "StepDocumentView.swift", "target-membership": [ "Stairstep/compile-sources" ] },
            { "path": "StepFileDocument.swift", "target-membership": [ "Stairstep/compile-sources" ] },
            { "path": "StepSceneCanvas.swift", "target-membership": [ "Stairstep/compile-sources" ] },
            { "path": "StepSceneLoader.swift", "target-membership": [ "Stairstep/compile-sources" ] },
            { "path": "StepViewCommands.swift", "target-membership": [ "Stairstep/compile-sources" ] },
            { "path": "StepMeasurementOverlay.swift", "target-membership": [ "Stairstep/compile-sources" ] },
            { "path": "StairsDistractionFree.swift", "target-membership": [ "Stairstep/compile-sources" ] },
            { "path": "SettingsSync.swift", "target-membership": [ "Stairstep/compile-sources" ] },
            { "path": "RealityStepCanvas.swift", "target-membership": [ "Stairstep/compile-sources" ] },
            { "path": "RealityStepShaders.metal", "target-membership": [ "Stairstep/compile-sources" ] },
            { "path": "RealityStepOverlays.swift", "target-membership": [ "Stairstep/compile-sources" ] },
            { "path": "StepModelVolume.swift", "target-membership": [ "Stairstep/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "StairsCore",
          "children": [
            { "path": "PlatformSupport.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "StepMaterialKey.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "StepSceneFactory.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "StepSceneModel.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "StepSectionPlane.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "StepSectionCap.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "StepSectionShader.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "StepSectionTriangulator.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "StepMeasurement.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "StepSnapModel.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "StepSectionSnap.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "StepMeshExporter.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "StepPrimaryView.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "StepSnapScene.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "ZipArchive.swift", "target-membership": [ "StairsCore/compile-sources" ] },
            { "path": "FCStdDocument.swift", "target-membership": [ "StairsCore/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "StairsStepImporter",
          "children": [
            {
              "path": "StairsStepImporter.cpp",
              "target-membership": [
                { "build-phase": "Stairstep/compile-sources", "arguments": "-Wno-documentation -Wno-deprecated-declarations" },
                { "build-phase": "StairsQuickLookPreview/compile-sources", "arguments": "-Wno-documentation -Wno-deprecated-declarations" },
                { "build-phase": "StairsQuickLookThumbnail/compile-sources", "arguments": "-Wno-documentation -Wno-deprecated-declarations" },
              ],
            }, {
              "kind": "group",
              "path": "include",
              "children": [
                { "path": "StairsStepImporter.h" },
                { "path": "module.modulemap" },
              ],
            },
          ],
        }, {
          "kind": "group",
          "path": "StairsQuickLookPreview",
          "children": [
            { "path": "PreviewViewController.swift", "target-membership": [ "StairsQuickLookPreview/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "StairsQuickLookThumbnail",
          "children": [
            { "path": "ThumbnailProvider.swift", "target-membership": [ "StairsQuickLookThumbnail/compile-sources" ] },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "App",
      "children": [
        { "path": "Info.plist" },
        { "path": "iOSInfo.plist" },
        {
          "kind": "group",
          "path": "Resources",
          "children": [
            { "path": "AppIcon.icon", "target-membership": [ "Stairstep/resources" ] },
            { "path": "Assets.xcassets", "target-membership": [ "Stairstep/resources" ] },
            { "path": "Stair Demo.step", "target-membership": [ "Stairstep/resources" ] },
          ],
        }, {
          "kind": "group",
          "path": "PlugIns",
          "children": [
            { "path": "QuickLookExtension.entitlements" },
            { "path": "StairsQuickLookPreview.appex/Contents/Info.plist" },
            { "path": "StairsQuickLookThumbnail.appex/Contents/Info.plist" },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "Vendor",
      "children": [
        { "path": "OpenCascadeStatic/OpenCascadeStairs.xcframework", "target-membership": [ "Stairstep/frameworks" ] },
        {
          "kind": "group",
          "path": "OpenCascadeStatic/macos-arm64/share/doc/opencascade",
          "name": "OpenCascadeStatic/macos-arm64/share/doc/opencascade",
          "children": [
            { "path": "LICENSE_LGPL_21.txt" },
            { "path": "OCCT_LGPL_EXCEPTION.txt" },
          ],
        }, {
          "kind": "group",
          "path": "RapidJSON",
          "children": [
            { "path": "license.txt" },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "scripts",
      "children": [
        { "path": "build-occt.sh" },
        { "path": "build-occt-ios.sh" },
        { "path": "build-occt-xcframework.sh" },
        { "path": "generate_app_icon.swift" },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        {
          "path": "<SDK>/System/Library/Frameworks/AppKit.framework",
          "target-membership": [
            { "build-phase": "Stairstep/frameworks", "platforms": [ "macos" ] },
            "StairsQuickLookPreview/frameworks",
            "StairsQuickLookThumbnail/frameworks",
          ],
        }, {
          "path": "<SDK>/System/Library/Frameworks/IOKit.framework",
          "target-membership": [
            { "build-phase": "Stairstep/frameworks", "platforms": [ "macos" ] },
            "StairsQuickLookPreview/frameworks",
            "StairsQuickLookThumbnail/frameworks",
          ],
        },
        { "path": "<SDK>/System/Library/Frameworks/OpenGLES.framework", "target-membership": [ { "build-phase": "Stairstep/frameworks", "platforms": [ "ios" ] } ] },
        { "path": "<SDK>/System/Library/Frameworks/QuartzCore.framework", "target-membership": [ { "build-phase": "Stairstep/frameworks", "platforms": [ "ios" ] } ] },
        { "path": "<SDK>/System/Library/Frameworks/QuickLookUI.framework", "target-membership": [ "StairsQuickLookPreview/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/QuickLookThumbnailing.framework", "target-membership": [ "StairsQuickLookThumbnail/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Stairstep.app", "id": "A00000000000000000000101", "type": "wrapper.application", "index": false },
        {
          "path": "<PRODUCTS>/libStairsCore.a",
          "id": "A00000000000000000000103",
          "type": "archive.ar",
          "index": false,
          "target-membership": [
            "Stairstep/frameworks",
            "StairsQuickLookPreview/frameworks",
            "StairsQuickLookThumbnail/frameworks",
          ],
        },
        { "path": "<PRODUCTS>/StairsQuickLookPreview.appex", "id": "A00000000000000000000105", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Stairstep/copy/Embed Foundation Extensions", "platforms": [ "macos" ], "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/StairsQuickLookThumbnail.appex", "id": "A00000000000000000000106", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Stairstep/copy/Embed Foundation Extensions", "platforms": [ "macos" ], "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Stairstep",
      "id": "D00000000000000000000001",
      "product": "Products/Stairstep.app",
      "product-type": "application",
      "dependencies": [
        "StairsCore",
        { "target": "StairsQuickLookPreview", "platforms": [ "macos" ] },
        { "target": "StairsQuickLookThumbnail", "platforms": [ "macos" ] },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "script",
          "name": "Copy Third-Party Notices",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/Vendor/OpenCascadeStatic/macos-arm64/share/doc/opencascade/LICENSE_LGPL_21.txt",
            "$(SRCROOT)/Vendor/OpenCascadeStatic/macos-arm64/share/doc/opencascade/OCCT_LGPL_EXCEPTION.txt",
            "$(SRCROOT)/Vendor/RapidJSON/license.txt",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/OpenCascade/LICENSE_LGPL_21.txt",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/OpenCascade/OCCT_LGPL_EXCEPTION.txt",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/RapidJSON/license.txt",
          ],
          "shell": "/bin/sh",
          "script": [
            "set -euo pipefail",
            "LICENSES_ROOT=\"$TARGET_BUILD_DIR/$UNLOCALIZED_RESOURCES_FOLDER_PATH/ThirdPartyLicenses\"",
            "OCCT_LICENSE_DIR=\"$SRCROOT/Vendor/OpenCascadeStatic/macos-arm64/share/doc/opencascade\"",
            "mkdir -p \"$LICENSES_ROOT/OpenCascade\" \"$LICENSES_ROOT/RapidJSON\"",
            "cp \"$OCCT_LICENSE_DIR/LICENSE_LGPL_21.txt\" \"$LICENSES_ROOT/OpenCascade/LICENSE_LGPL_21.txt\"",
            "cp \"$OCCT_LICENSE_DIR/OCCT_LGPL_EXCEPTION.txt\" \"$LICENSES_ROOT/OpenCascade/OCCT_LGPL_EXCEPTION.txt\"",
            "cp \"$SRCROOT/Vendor/RapidJSON/license.txt\" \"$LICENSES_ROOT/RapidJSON/license.txt\"",
            "",
          ],
        },
      ],
      "build-settings": {
        "ARCHS": "arm64",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CLANG_CXX_LANGUAGE_STANDARD": "c++17",
        "CLANG_CXX_LIBRARY": "libc++",
        "CODE_SIGNING_ALLOWED": "YES",
        "CODE_SIGN_ENTITLEMENTS[sdk=iphone*]": "App/Stairs-iOS.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]": "App/Stairs.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "2",
        "DEAD_CODE_STRIPPING": "YES",
        "DEFINES_MODULE": "YES",
        "DEVELOPMENT_TEAM": "257KW9ZJFP",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_MODULE_VERIFIER": "YES",
        "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "x86_64",
        "GENERATE_INFOPLIST_FILE": "YES",
        "HEADER_SEARCH_PATHS": [
          "$(inherited)",
          "$(SRCROOT)/Sources/StairsStepImporter/include",
          "$(SRCROOT)/Vendor/OpenCascadeStatic/OpenCascadeStairs.xcframework/macos-arm64/Headers",
        ],
        "HEADER_SEARCH_PATHS[sdk=iphoneos*]": [
          "$(inherited)",
          "$(SRCROOT)/Sources/StairsStepImporter/include",
          "$(SRCROOT)/Vendor/OpenCascadeStatic/OpenCascadeStairs.xcframework/ios-arm64/Headers",
        ],
        "HEADER_SEARCH_PATHS[sdk=iphonesimulator*]": [
          "$(inherited)",
          "$(SRCROOT)/Sources/StairsStepImporter/include",
          "$(SRCROOT)/Vendor/OpenCascadeStatic/OpenCascadeStairs.xcframework/ios-arm64-simulator/Headers",
        ],
        "HEADER_SEARCH_PATHS[sdk=xros*]": [
          "$(inherited)",
          "$(SRCROOT)/Sources/StairsStepImporter/include",
          "$(SRCROOT)/Vendor/OpenCascadeStatic/OpenCascadeStairs.xcframework/xros-arm64/Headers",
        ],
        "HEADER_SEARCH_PATHS[sdk=xrsimulator*]": [
          "$(inherited)",
          "$(SRCROOT)/Sources/StairsStepImporter/include",
          "$(SRCROOT)/Vendor/OpenCascadeStatic/OpenCascadeStairs.xcframework/xros-arm64-simulator/Headers",
        ],
        "INFOPLIST_FILE": "App/Info.plist",
        "INFOPLIST_FILE[sdk=iphoneos*]": "App/iOSInfo.plist",
        "INFOPLIST_FILE[sdk=iphonesimulator*]": "App/iOSInfo.plist",
        "INFOPLIST_FILE[sdk=xros*]": "App/iOSInfo.plist",
        "INFOPLIST_FILE[sdk=xrsimulator*]": "App/iOSInfo.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Stairstep",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphoneos*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphonesimulator*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=xros*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=xrsimulator*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "1.1.1",
        "MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS": "gnu17 c++17",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twarge.app.Stairs",
        "PRODUCT_NAME": "Stairstep",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_INCLUDE_PATHS": "$(SRCROOT)/Sources/StairsStepImporter/include",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TARGETED_DEVICE_FAMILY[sdk=xros*]": "7",
        "TARGETED_DEVICE_FAMILY[sdk=xrsimulator*]": "7",
        "XROS_DEPLOYMENT_TARGET": "26.0",
      },
    }, {
      "name": "StairsCore",
      "id": "D00000000000000000000003",
      "product": "Products/libStairsCore.a",
      "product-type": "library.static",
      "build-phases": [
        "compile-sources",
      ],
      "build-settings": {
        "ARCHS": "arm64",
        "DEAD_CODE_STRIPPING": "YES",
        "DEFINES_MODULE": "YES",
        "ENABLE_MODULE_VERIFIER": "YES",
        "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "x86_64",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "MACH_O_TYPE": "staticlib",
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS": "gnu17 c++17",
        "PRODUCT_MODULE_NAME": "StairsCore",
        "PRODUCT_NAME": "StairsCore",
        "SDKROOT": "auto",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SWIFT_INCLUDE_PATHS": "$(SRCROOT)/Sources/StairsStepImporter/include",
        "SWIFT_VERSION": "6.0",
        "XROS_DEPLOYMENT_TARGET": "26.0",
      },
    }, {
      "name": "StairsQuickLookPreview",
      "id": "D00000000000000000000005",
      "product": "Products/StairsQuickLookPreview.appex",
      "product-type": "app-extension",
      "dependencies": [
        "StairsCore",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "ARCHS": "arm64",
        "CODE_SIGN_ENTITLEMENTS": "App/PlugIns/QuickLookExtension.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "2",
        "DEAD_CODE_STRIPPING": "YES",
        "DEFINES_MODULE": "YES",
        "DEVELOPMENT_TEAM": "257KW9ZJFP",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_MODULE_VERIFIER": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "HEADER_SEARCH_PATHS": [
          "$(inherited)",
          "$(SRCROOT)/Sources/StairsStepImporter/include",
          "$(SRCROOT)/Vendor/OpenCascadeStatic/macos-arm64/include/opencascade",
        ],
        "INFOPLIST_FILE": "App/PlugIns/StairsQuickLookPreview.appex/Contents/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Stairstep Quick Look",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
