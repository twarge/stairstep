<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Stairstep</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>step</string>
				<string>stp</string>
				<string>p21</string>
				<string>iges</string>
				<string>igs</string>
				<string>brep</string>
				<string>rle</string>
				<string>stl</string>
				<string>obj</string>
				<string>glb</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>3D Model</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.twarge.stairs.step</string>
				<string>com.twarge.stairs.iges</string>
				<string>com.twarge.stairs.brep</string>
				<string>com.twarge.stairs.stl</string>
				<string>com.twarge.stairs.obj</string>
				<string>com.twarge.stairs.glb</string>
			</array>
		</dict>
		<!-- Files named .stl, .obj and .glb carry the system's types, not
		     the app's own, so the app is offered for them only if it claims
		     those too. Alternate: it opens them without taking them from
		     the app that already does. The system's PLY type is left out
		     because the importer cannot read PLY. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>3D Model</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.standard-tesselated-geometry-format</string>
				<string>public.geometry-definition-format</string>
				<string>org.khronos.glb</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>26.0</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportsDocumentBrowser</key>
	<true/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<!-- UTTypeIcons has the system draw each type's document icon: the
		     app icon on a folded page, labelled with the format. Without it
		     the text formats get the text-document icon. Files named .stl,
		     .ply, .obj and .glb resolve to the system's own types for those
		     extensions, so those four labels show only on a system that has
		     no such type. -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.3d-content</string>
				<string>public.text</string>
			</array>
			<key>UTTypeDescription</key>
			<string>STEP Model</string>
			<key>UTTypeIcons</key>
			<dict>
				<key>UTTypeIconText</key>
				<string>step</string>
			</dict>
			<key>UTTypeIdentifier</key>
			<string>com.twarge.stairs.step</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>step</string>
					<string>stp</string>
					<string>p21</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.3d-content</string>
				<string>public.text</string>
			</array>
			<key>UTTypeDescription</key>
			<string>IGES Model</string>
			<key>UTTypeIcons</key>
			<dict>
				<key>UTTypeIconText</key>
				<string>iges</string>
			</dict>
			<key>UTTypeIdentifier</key>
			<string>com.twarge.stairs.iges</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>iges</string>
					<string>igs</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.3d-content</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Open CASCADE BREP Model</string>
			<key>UTTypeIcons</key>
			<dict>
				<key>UTTypeIconText</key>
				<string>brep</string>
			</dict>
			<key>UTTypeIdentifier</key>
			<string>com.twarge.stairs.brep</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>brep</string>
					<string>rle</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.3d-content</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>STL Model</string>
			<key>UTTypeIcons</key>
			<dict>
				<key>UTTypeIconText</key>
				<string>stl</string>
			</dict>
			<key>UTTypeIdentifier</key>
			<string>com.twarge.stairs.stl</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>stl</string>
				</array>
			</dict>
		</dict>
		<!-- PLY is written by Export only. The importer has no PLY reader,
		     so no document type lists this type. -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.3d-content</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>PLY Model</string>
			<key>UTTypeIcons</key>
			<dict>
				<key>UTTypeIconText</key>
				<string>ply</string>
			</dict>
			<key>UTTypeIdentifier</key>
			<string>com.twarge.stairs.ply</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ply</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.3d-content</string>
				<string>public.text</string>
			</array>
			<key>UTTypeDescription</key>
			<string>OBJ Model</string>
			<key>UTTypeIcons</key>
			<dict>
				<key>UTTypeIconText</key>
				<string>obj</string>
			</dict>
			<key>UTTypeIdentifier</key>
			<string>com.twarge.stairs.obj</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>obj</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.3d-content</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Binary glTF Model</string>
			<key>UTTypeIcons</key>
			<dict>
				<key>UTTypeIconText</key>
				<string>glb</string>
			</dict>
			<key>UTTypeIdentifier</key>
			<string>com.twarge.stairs.glb</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>glb</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
